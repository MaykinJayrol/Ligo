PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5434
DB_USER=cashin
DB_PASSWORD=cashin
DB_NAME=cashin

# Mock provider behavior: success | fail | timeout
PROVIDER_MODE=success
PROVIDER_TIMEOUT_MS=50
PROVIDER_LATENCY_MS=20

# Safe retries only for transient infrastructure errors (never for charge)
DB_RETRY_ATTEMPTS=3
DB_RETRY_BASE_MS=50
